#!/usr/bin/env bash

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
LIB_DIR="$SCRIPT_DIR/../lib"

# Load libs
source "$LIB_DIR/common.sh"
source "$LIB_DIR/log.sh"
source "$LIB_DIR/yay.sh"
source "$LIB_DIR/github.sh"
source "$LIB_DIR/search.sh"
source "$LIB_DIR/pkgb.sh"
source "$LIB_DIR/js.sh"
source "$LIB_DIR/i18n.sh"
source "$LIB_DIR/report.sh"
source "$LIB_DIR/verify_rules.sh"
source "$LIB_DIR/verify.sh"
source "$LIB_DIR/aur_plain.sh"

# Defaults (can be overridden via env)
YAY_BIN="${YAY_BIN:-yay}"
STRICT="${STRICT:-0}"
VERIFY_ONLY="${VERIFY_ONLY:-0}"
FAST="${FAST:-0}"
NO_PROMPT="${NO_PROMPT:-0}"
VERBOSE="${VERBOSE:-0}"
QUIET="${QUIET:-0}"

# Required tools
require_tools "$YAY_BIN" git sed awk tr grep cut head sort uniq curl tar makepkg sha256sum

main() {
  local input="" seen_input=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --verify-only) VERIFY_ONLY=1; shift; continue;;
      --fast)        FAST=1; shift; continue;;
      --strict)      STRICT=1; shift; continue;;
      --verbose)     VERBOSE=1; shift; continue;;
      --quiet)       QUIET=1; shift; continue;;
      --)            shift; # everything after -- is positional
                      if [ $# -gt 0 ]; then
                        if [ "$seen_input" -eq 1 ]; then die "Multiple inputs provided"; fi
                        input="$1"; seen_input=1; shift
                      fi
                      break;;
      -*)            die "Unknown option: $1" ;;
      *)             if [ "$seen_input" -eq 0 ]; then input="$1"; seen_input=1; shift; else die "Multiple inputs provided"; fi;;
    esac
  done
  [ -n "$input" ] || die "Usage: $0 [--verify-only] [--fast] [--strict] <aur_pkg|aur_url|github_url>"

  local pkg
  # Auto-detect input type and prefer AUR plain endpoints when possible
  if [[ "$input" =~ ^https?://aur\.archlinux\.org/packages/[^/]+$ ]]; then
    pkg="${input##*/}"
  elif is_github_url "$input"; then
    pkg="$(resolve_pkg "$input")" || true
  else
    # Bare token: check AUR RPC first to avoid relying on yay search (single request)
    local rpc_json
    rpc_json="$(aur_plain_rpc_info "$input" 2>/dev/null || true)"
    if printf '%s' "$rpc_json" | grep -Eq '"resultcount"[[:space:]]*:[[:space:]]*1' \
       && printf '%s' "$rpc_json" | grep -Eq '"Name"[[:space:]]*:[[:space:]]*"'$input'"'; then
      pkg="$input"
    else
      pkg="$(resolve_pkg "$input")" || true
    fi
  fi
  [ -n "${pkg:-}" ] || die "Unable to resolve an AUR package from input."
  log_info "Resolved package: $pkg"
  # Verbose implies showing function summaries and detailed logs
  if [ "$VERBOSE" = "1" ]; then SHOW_FUNCS=1; QUIET=0; fi
  # Quiet overrides verbose/show funcs
  if [ "$QUIET" = "1" ]; then SHOW_FUNCS=0; VERBOSE=0; fi
  install_or_verify "$pkg"
}

main "$@"

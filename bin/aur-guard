#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025 José Luis López López Prieto <ing.jlllopezp@gmail.com>
# Author GitHub: https://github.com/LuigiD5555
# aur-guard — run AUR verification before yay/paru/pikaur/trizen/pamac (and similar helpers)
#
# Purpose
# - Can be symlinked as your helper (e.g., ~/.local/bin/yay -> aur-guard) or used explicitly:
#     aur-guard yay -S <pkgs>
# - Detects target packages, runs bin/aur-verify --verify-only, and if OK delegates to the real helper.
#
# Critical fix
# - Do NOT clobber "$@" when reading helpers.list. We parse into variables (read -r helper kind) and keep args intact.

set -euo pipefail
IFS=$'\n\t'

# ---------- Logging ----------
log()   { printf '[aur-guard] %s\n' "$*"; }
dbg()   { [[ "${GUARD_DEBUG:-0}" = 1 ]] && printf '[aur-guard][debug] %s\n' "$*"; true; }
warn()  { printf '[aur-guard][warn] %s\n' "$*" >&2; }
die()   { printf '[aur-guard][error] %s\n' "$*" >&2; exit 1; }

# ---------- Resolve paths ----------
_self_path="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  _resolved="$(readlink -f "$_self_path" 2>/dev/null || true)"
  [[ -n "${_resolved:-}" ]] && _self_path="$_resolved"
fi
SCRIPT_DIR="$(cd -- "$(dirname -- "$_self_path")" && pwd)"
ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"

HELPERS_LIST="$ROOT_DIR/lib/guard/helpers.list"
AUR_VERIFY_BIN="$ROOT_DIR/bin/aur-verify"

# Keep the original arguments intact for the whole run
orig_args=("$@")

# ---------- Load helper kinds WITHOUT altering "$@" ----------
# helpers.list format (first two whitespace-separated fields):
#   yay     pacman
#   pamac   pamac
declare -A GUARD_HELPER_KIND=()
if [[ -f "$HELPERS_LIST" ]]; then
  while IFS= read -r line; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    read -r helper kind _ <<<"$line"
    [[ -z "${helper:-}" || -z "${kind:-}" ]] && continue
    GUARD_HELPER_KIND["$helper"]="$kind"
  done < "$HELPERS_LIST"
else
  warn "helpers.list not found at: $HELPERS_LIST (defaulting to pacman style)"
fi

# ---------- Determine target helper and arguments ----------
invoked_as="$(basename -- "$0")"
target_tool=""
case "$invoked_as" in
  aur-guard)
    [[ $# -ge 1 ]] || die "Usage: aur-guard <helper> [args...]"
    target_tool="$1"; shift 1
    ;;
  *)
    # Symlink mode: invoked as "yay", "paru", "pamac", etc.
    target_tool="$invoked_as"
    ;;
esac

# Defensive: restore original args (in case anything touched them earlier)
set -- "${orig_args[@]}"

# ---------- Find the real helper binary (avoid recursion) ----------
find_real_cmd() {
  local tool="$1" upper override_var override_path path cand
  upper="$(printf '%s' "$tool" | tr '[:lower:]' '[:upper:]')"
  override_var="AUR_GUARD_REAL_${upper}"
  override_path="${!override_var:-}"

  if [[ -n "$override_path" && -x "$override_path" ]]; then
    printf '%s\n' "$override_path"
    return 0
  fi

  if path="$(command -v -- "$tool" 2>/dev/null)"; then
    local real="$(readlink -f "$path" 2>/dev/null || printf '%s' "$path")"
    local self="$(readlink -f "$_self_path" 2>/dev/null || printf '%s' "$_self_path")"
    if [[ "$real" != "$self" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  fi

  for cand in "/usr/bin/$tool" "/bin/$tool" "/usr/local/bin/$tool"; do
    if [[ -x "$cand" ]]; then
      local real="$(readlink -f "$cand" 2>/dev/null || printf '%s' "$cand")"
      local self="$(readlink -f "$_self_path" 2>/dev/null || printf '%s' "$_self_path")"
      if [[ "$real" != "$self" ]]; then
        printf '%s\n' "$cand"
        return 0
      fi
    fi
  done

  return 1
}

# ---------- Candidate collection ----------
collect_targets_pacman_style() {
  # pacman-like: packages commonly after -S / -U and any non-flag tokens
  local args=("$@") a have_action=0 targets=()
  for a in "${args[@]}"; do
    if [[ "$a" == -* ]]; then
      [[ "$a" =~ ^-S ]] && have_action=1
      [[ "$a" =~ ^-U ]] && have_action=1
      continue
    fi
    targets+=("$a")
  done
  if [[ $have_action -eq 1 && ${#targets[@]} -gt 0 ]]; then
    printf '%s\n' "${targets[@]}"
  fi
}

collect_targets_pamac_style() {
  # pamac: subcommands like build/install/upgrade followed by pkgs
  local args=("$@") sub="" a targets=()
  for a in "${args[@]}"; do
    if [[ -z "$sub" && "${a#-}" = "$a" ]]; then
      sub="$a"; continue
    fi
    if [[ "$a" != -* ]]; then
      targets+=("$a")
    fi
  done
  case "$sub" in
    build|install|upgrade)
      [[ ${#targets[@]} -gt 0 ]] && printf '%s\n' "${targets[@]}"
      ;;
    *) : ;;
  esac
}

# ---------- Verification wrapper (keeps your previous flow name) ----------
verify_aur_targets() {
  local real_helper="$1"; shift
  local toolbase; toolbase="$(basename -- "$real_helper")"
  local kind="${GUARD_HELPER_KIND[$toolbase]:-$toolbase}"
  local -a candidates=()

  case "$kind" in
    pamac)    mapfile -t candidates < <(collect_targets_pamac_style "$@") ;;
    pacman|*) mapfile -t candidates < <(collect_targets_pacman_style "$@") ;;
  esac

  if [[ ${#candidates[@]} -eq 0 ]]; then
    dbg "no candidates extracted for verification"
    return 0
  fi

  if [[ ! -x "$AUR_VERIFY_BIN" ]]; then
    warn "aur-verify not found at: $AUR_VERIFY_BIN — delegating without verification"
    return 0
  fi

  dbg "verifying candidates: ${candidates[*]}"
  "$AUR_VERIFY_BIN" --verify-only -- "${candidates[@]}"
}

# ---------- Main ----------
real_cmd="$(find_real_cmd "$target_tool")" || die "Cannot locate real helper for '$target_tool'."
dbg "real_cmd=$real_cmd"

if ! verify_aur_targets "$real_cmd" "$@"; then
  warn "verification failed — aborting"
  exit 2
fi

dbg "verification passed (or skipped) — delegating to real helper"
exec "$real_cmd" "$@"

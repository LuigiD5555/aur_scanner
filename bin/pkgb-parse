/*
  pkgb-parse — Modern PKGBUILD static parser (modular)

  Usage:
    pkgb-parse --file /path/to/PKGBUILD [--summary|--json|--signals]
    pkgb-parse --url https://aur.archlinux.org/cgit/aur.git/plain/PKGBUILD?h=package-name
    cat PKGBUILD | pkgb-parse [--summary|--json]
*/

import fs from 'fs/promises';
import path from 'path';
import { fileURLToPath } from 'url';
import { fetchFromURL } from '../lib/pkgb/parser/utils/modules/networkFetch.js';
import { readStdin } from '../lib/pkgb/parser/utils/modules/stdinRead.js';
import { parsePKGBUILD } from '../lib/pkgb/parser/analysis.js';
import { colorize } from '../lib/pkgb/parser/terminalColors.js';
import { printDetailedAnalysis } from '../lib/pkgb/parser/outputs/modules/renderDetailedAnalysis.js';
import { printSummary } from '../lib/pkgb/parser/outputs/modules/renderSummaryLine.js';
import { printSignals } from '../lib/pkgb/parser/outputs/modules/renderSignalsKeyValue.js';
import { printRedflagsLines } from '../lib/pkgb/parser/outputs/modules/renderRedflagsLines.js';
import { printSourcesCompact } from '../lib/pkgb/parser/outputs/modules/renderCompactSources.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

async function main() {
  const args = process.argv.slice(2);
  let file = null;
  let url = null;
  let summary = false;
  let json = false;
  let signals = false;
  let redflagsLines = false;
  let sourcesCompact = false;
  let limit = 0;
  
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    switch (arg) {
      case '--file':
        if (i + 1 < args.length) file = args[++i];
        break;
      case '--url':
        if (i + 1 < args.length) url = args[++i];
        break;
      case '--summary':
        summary = true;
        break;
      case '--json':
        json = true;
        break;
      case '--signals':
        signals = true;
        break;
      case '--redflags-lines':
        redflagsLines = true;
        break;
      case '--sources-compact':
        sourcesCompact = true;
        break;
      case '--limit':
        if (i + 1 < args.length) { limit = parseInt(args[++i], 10) || 0; }
        break;
      case '--help':
      case '-h':
        console.log(`
${colorize('Usage:', 'bold')} pkgb-parse [OPTIONS]

${colorize('Options:', 'bold')}
  --file PATH         Parse PKGBUILD from file
  --url URL           Fetch and parse PKGBUILD from URL
  --summary           Show brief summary line
  --json              Output raw JSON
  --signals           Show key=value pairs
  --redflags-lines    Print red flags as "line\tcontent"
  --sources-compact   Print compact sources list (optionally limited)
  --limit N           Limit items for compact output
  --help, -h         Show this help

${colorize('Examples:', 'bold')}
  pkgb-parse --file ./PKGBUILD
  pkgb-parse --url https://aur.archlinux.org/cgit/aur.git/plain/PKGBUILD?h=zotero
  curl -s "https://aur.archlinux.org/cgit/aur.git/plain/PKGBUILD?h=discord" | pkgb-parse
`);
        process.exit(0);
    }
  }

  let data;
  try {
    if (url) {
      // AUR hint and friendlier message when fetching from aur.archlinux.org
      const isAur = /\baur\.archlinux\.org\b/.test(url);
      if (isAur && !/\/plain\/PKGBUILD\b/.test(url)) {
        console.error(colorize('Tip: For AUR packages, use URLs like:', 'yellow'));
        console.error(colorize('https://aur.archlinux.org/cgit/aur.git/plain/PKGBUILD?h=package-name', 'gray'));
      }
      process.stderr.write(colorize(isAur ? 'Fetching from AUR (respectfully)... ' : 'Fetching from URL... ', 'gray'));
      data = await fetchFromURL(url);
      process.stderr.write(colorize('done\n', 'green'));
    } else if (file) {
      data = await fs.readFile(path.resolve(file), 'utf8');
    } else {
      data = await readStdin();
    }

    const parsed = parsePKGBUILD(data);
    
    if (json) {
      console.log(JSON.stringify(parsed, null, 2));
    } else if (summary) {
      printSummary(parsed);
    } else if (signals) {
      printSignals(parsed);
    } else if (redflagsLines) {
      printRedflagsLines(parsed);
    } else if (sourcesCompact) {
      printSourcesCompact(parsed, limit);
    } else {
      printDetailedAnalysis(parsed);
    }
    
  } catch (error) {
    console.error(colorize(`Error: ${error.message}`, 'red'));
    process.exit(1);
  }
}

// Handle unhandled promises
process.on('unhandledRejection', (reason, promise) => {
  console.error(colorize('Unhandled Rejection:', 'red'), reason);
  process.exit(1);
});

main();

post_install() {
  cat <<'MSG'
==> aur-scanner-git (beta)
    The core wrapper files were installed to /usr/lib/aur-scanner.
    To integrate with yay/paru/pikaur run:
      sudo /usr/lib/aur-scanner/scripts/install-scanner.sh --system
    or configure shims manually if you prefer.
MSG
}

post_upgrade() {
  post_install
}

post_remove() {
  cat <<'MSG'
==> aur-scanner-git removed.
    You may want to delete any helper shims the wrapper created in ~/.local/bin or /usr/local/bin.
MSG
}
